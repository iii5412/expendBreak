# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for GPT live voice chat.
# Store this only in AI Studio / Cloud Run secrets. Never expose it to Vite client env.
OPENAI_API_KEY=""

# GPT Realtime defaults. The mini model keeps everyday voice-assistant costs low.
OPENAI_REALTIME_MODEL="gpt-realtime-2.1-mini"
OPENAI_REALTIME_VOICE="marin"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: HTTPS origin used only by the bundled Android app.
# Leave empty for the same-origin web/PWA build. Do not include a trailing slash.
VITE_API_BASE_URL=""

# Comma-separated exact origins allowed to call the API from a native WebView.
# Capacitor Android uses https://localhost by default.
NATIVE_ALLOWED_ORIGINS="https://localhost"

# Optional self-update feed for directly distributed Android APKs.
# Use the same release signing key for every version and increment versionCode.
APP_UPDATE_APK_PATH=""
APP_UPDATE_VERSION_CODE=""
APP_UPDATE_VERSION_NAME=""
APP_UPDATE_RELEASE_NOTES=""

# APP_PIN_HASH: Required in production. Generate with `npm run pin:hash -- 123456`.
# Store this value in AI Studio / Cloud Run secrets. Never commit the real hash.
APP_PIN_HASH=""

# OWNER_UID: Fixed Firebase UID used by this single-owner app.
OWNER_UID="owner"

# APP_ACCESS_KEY: Temporary compatibility fallback only. APP_PIN_HASH takes precedence.
# Remove this after the first successful PIN-hash deployment.
APP_ACCESS_KEY=""
