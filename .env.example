# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Low-latency structured classifier. Override only after measuring production latency/quality.
GEMINI_CLASSIFY_MODEL="gemini-3.5-flash-lite"
GEMINI_CHAT_MODEL="gemini-3.8-flash"

# OPENAI_API_KEY: Required for GPT live voice chat.
# Store this only in AI Studio / Cloud Run secrets. Never expose it to Vite client env.
OPENAI_API_KEY=""

# GPT Realtime defaults. The mini model keeps everyday voice-assistant costs low.
OPENAI_REALTIME_MODEL="gpt-realtime-2.1-mini"
OPENAI_REALTIME_VOICE="marin"
OPENAI_CHAT_MODEL="gpt-6-luna"
# Optional: model for the AI tab Agent (tool calling). Defaults to OPENAI_CHAT_MODEL.
OPENAI_AGENT_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: HTTPS origin used only by the bundled Android app.
# Leave empty for the same-origin web/PWA build. Do not include a trailing slash.
VITE_API_BASE_URL=""

# Comma-separated exact origins allowed to call the API from a native WebView.
# Capacitor Android uses https://localhost by default.
NATIVE_ALLOWED_ORIGINS="https://localhost"

# Optional self-update feed for directly distributed Android APKs.
# Use the same release signing key for every version and increment versionCode.
APP_UPDATE_APK_PATH=""
APP_UPDATE_VERSION_CODE=""
APP_UPDATE_VERSION_NAME=""
APP_UPDATE_RELEASE_NOTES=""

# APP_PIN_HASH: Required in production (must start with pbkdf2$). Generate with `npm run pin:hash -- 123456`.
# The hashing scripts accept 6-12 digit PINs only.
# Store this value in AI Studio / Cloud Run secrets. Never commit the real hash.
APP_PIN_HASH=""

# OWNER_UID: Firebase UID that owns the existing ledger data.
OWNER_UID="owner"

# OWNER_NAME: Label shown after the original owner logs in.
OWNER_NAME="내 계정"

# APP_ACCOUNTS_JSON: Optional additional, fully isolated accounts.
# Generate one entry with: npm run account:hash -- wife "와이프" 654321
# Keep each UID and PIN unique. Store the generated JSON as one deployment secret.
APP_ACCOUNTS_JSON='[{"uid":"wife","name":"와이프","pinHash":"pbkdf2$..."}]'

# APP_SESSION_SECRET: Required in production, at least 32 bytes. Generate with `openssl rand -base64 48`.
# Development without it uses a random per-process key, so a restart signs everyone out.
APP_SESSION_SECRET=""

# APP_SESSION_SECRET_PREVIOUS: Optional. The old signing value, accepted for one deploy while rotating keys.
# When moving off the old PIN-hash signing, put the previous APP_PIN_HASH here, then remove it next deploy.
APP_SESSION_SECRET_PREVIOUS=""

# TRUST_PROXY_HOPS: Number of proxies in front of the server. Cloud Run uses 1 (the default).
# PIN failure limits key on the client IP taken from X-Forwarded-For through this many hops.
TRUST_PROXY_HOPS="1"

# PIN_MIN_LENGTH: Minimum accepted PIN length (default 4). Raise to 6 after every account has a 6+ digit PIN.
PIN_MIN_LENGTH="4"

# APP_ACCESS_KEY: Development-only plaintext PIN. Production refuses to start with it instead of APP_PIN_HASH.
APP_ACCESS_KEY=""
