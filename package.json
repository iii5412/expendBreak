{
  "name": "expendbreak",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server-dist/server.cjs",
    "build:web": "vite build",
    "android:sync": "node scripts/prepare-android.mjs",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "node scripts/prepare-android.mjs --release && cd android && gradlew.bat assembleRelease",
    "start": "node server-dist/server.cjs",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','server-dist','server.js']) fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "pin:hash": "node scripts/hash-pin.mjs",
    "account:hash": "node scripts/hash-account.mjs",
    "session:revoke": "node scripts/revoke-session.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-expendbreak-rules \"vitest run --config vitest.rules.config.ts\"",
    "lint:eslint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.32.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  }
}
